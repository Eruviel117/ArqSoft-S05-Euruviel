@model Citas_App.Models.Medico
@{
    ViewData["Title"] = $"{Model.Nombre} {Model.Apellido}";
}

<div class="detail-card">
    <a class="btn-back" asp-action="Index">← Volver a la lista</a>

    <div class="detail-avatar mt-3">
        @Model.Nombre[0]@Model.Apellido[0]
    </div>

    <div class="detail-name">@Model.Nombre @Model.Apellido</div>

    <div class="detail-row">
        <span class="detail-icon">🩺</span>
        <span class="detail-label">Especialidad</span>
        <span class="detail-value">@Model.Especialidad</span>
    </div>
    <div class="detail-row">
        <span class="detail-icon">🪪</span>
        <span class="detail-label">Núm. licencia</span>
        <span class="detail-value">@Model.NumeroLicencia</span>
    </div>

    <div class="detail-actions">
        <a class="btn-back" asp-action="Index">← Volver</a>
    </div>
</div>